# Variables NEXT_PUBLIC_* : publiques, figées dans le code envoyé au navigateur à la construction.
# Jamais de secret dans une variable NEXT_PUBLIC_*.
# Vide = même origine : le navigateur appelle /api sur ce serveur, qui relaie vers le backend.
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_ENABLE_MOCKS=false

# Variable serveur uniquement (non publique) : cible du relais /api.
API_PROXY_TARGET=http://localhost:8080
