# Modèle de production. Copier en .env.production.local (ignoré par git) ou poser ces
# variables dans l'environnement de l'hébergeur. Ne jamais committer le fichier rempli.

# Publiques : figées dans le code envoyé au navigateur au moment du build. Jamais de secret.
# Vide = même origine : le navigateur appelle /api sur ce serveur, qui relaie vers le backend.
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_APP_ENV=production
# true en production = le front refuse de démarrer.
NEXT_PUBLIC_ENABLE_MOCKS=false

# Serveur uniquement : cible du relais /api (domaine public ou adresse interne du backend).
API_PROXY_TARGET=https://<domaine-api>
